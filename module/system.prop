# tweak low memory killer module
# sys.lmk.minfree_levels=2560:0,12800:100,25600:200,99840:250,115200:900,131072:950
# sets vendor usb use_ffs_mtp to 0 to force vendor to stop using samsung ffs mtp
vendor.usb.use_ffs_mtp=0
persist.sys.phh.remote=false
persist.debug.wfd.enable=1
# fixes boot on gsis with enforcing control privapp permissions state
ro.control_privapp_permissions=log
# these options are for enabling VoLTE and VoWiFi
# I hope they work tho
persist.sys.cust.lte_config=true
persist.rcs.supported=1
persist.dbg.ims_volte_enable=1
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.radio.calls.on.ims=1
persist.radio.VT_ENABLE=1
# Data options, might break VoWiFi
persist.data.iwlan.enable=true
persist.data.iwlan=1
persist.data.iwlan.ipsec.ap=1
# (Thanks phh) some camera libraries do not expose auxiliary cameras when 
# this property is not set 0, since then it sees that it is not running a 
# genuine samsung firmware.
vendor.gsi.test=0
ro.wifi.p2p_supported=true
